  "fact_types": [
    "catalog",
    "national_score_line",
    "school_score_line",
    "department_score_line",
    "major_score_line",
    "direction_score_line",
    "admitted_count",
    "initial_score_min",
    "initial_score_avg",
    "initial_score_max",
    "retest_score",
    "final_score"
  ],
  "year_mapping": {
